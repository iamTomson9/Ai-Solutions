## Database Schema (SQLite)

```sql
-- Users
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL,
    phone TEXT,
    company TEXT,
    country TEXT,
    date_of_birth TEXT,
    gender TEXT,
    profile_image TEXT,
    role TEXT NOT NULL DEFAULT 'customer',  -- 'customer', 'sales', 'admin'
    is_verified INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Products (Software products with price)
CREATE TABLE products (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    price REAL,
    description TEXT,
    banner_image TEXT,
    created_by TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Demos (with date/time and location)
CREATE TABLE demos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    demo_type TEXT,
    date_time TEXT NOT NULL,
    location TEXT,
    description TEXT,
    banner_image TEXT,
    created_by TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Events (with date/time and location)
CREATE TABLE events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    event_type TEXT,
    date_time TEXT NOT NULL,
    location TEXT,
    description TEXT,
    banner_image TEXT,
    created_by TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Bookings / RSVPs
CREATE TABLE bookings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    item_id INTEGER NOT NULL,
    item_type TEXT NOT NULL,  -- 'product', 'demo', 'event'
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Likes
CREATE TABLE likes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    item_id INTEGER NOT NULL,
    item_type TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Inquiries
CREATE TABLE inquiries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    user_name TEXT,
    message TEXT NOT NULL,
    item_id INTEGER,
    item_type TEXT,
    status TEXT DEFAULT 'open',  -- 'open', 'responded'
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Feedback
CREATE TABLE feedback (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    user_name TEXT,
    rating INTEGER NOT NULL,
    comment TEXT,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Chat History
CREATE TABLE chat_messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    sender TEXT NOT NULL,  -- 'user', 'ai', 'sales'
    message TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Login History
CREATE TABLE login_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    logged_in_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Analytics
CREATE TABLE analytics (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    type TEXT NOT NULL,
    data TEXT,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Escalations
CREATE TABLE escalations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_email TEXT NOT NULL,
    status TEXT DEFAULT 'pending',  -- 'pending', 'resolved'
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);
```

